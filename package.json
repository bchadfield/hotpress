{
  "name": "@benchadfield/hotpress",
  "version": "0.2.0",
  "description": "A small static site generator for content sites: collections, hierarchies, JSX components and SEO output, plus a parity checker.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Ben Chadfield",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bchadfield/hotpress.git"
  },
  "homepage": "https://github.com/bchadfield/hotpress#readme",
  "bugs": {
    "url": "https://github.com/bchadfield/hotpress/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "hotpress": "dist/cli.js"
  },
  "exports": {
    ".": {
      "hotpress-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "hotpress-source": "./src/jsx/jsx-runtime.ts",
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "hotpress-source": "./src/jsx/jsx-runtime.ts",
      "types": "./dist/jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx/jsx-runtime.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "static-site-generator",
    "ssg",
    "jsx",
    "seo",
    "netlify"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/basic/tsconfig.json",
    "test": "node --conditions=hotpress-source --test --test-reporter=spec \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "dev:cli": "node --conditions=hotpress-source src/cli.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "htmlparser2": "^12.0.0",
    "markdown-it": "^15.0.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "^3.1.0",
    "sharp": ">=0.34.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts"
}
